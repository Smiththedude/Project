{% extends "main.j2" %}
{% block content %}

<h1>Town_Quests</h1>

{# READ table #}
<table>
    <thead>
        <tr>
            {% for key in town_quests[0].keys() %}
            <th>{{ key }}</th>
            {% endfor %}
        </tr>
    </thead>

    <tbody>
        {# For each row, get the townid, town, questid, and quest #}
        {% for town_quest in town_quests %}
        <tr>
            <td>{{ town_quest.Towns_TownID }}</td>
            <td>{{ town_quest.Town }}</td>
            <td>{{ town_quest.Quests_QuestID }}</td>
            <td>{{ town_quest.Quest }}</td>

            {# DELETE form #}
            <form id="delete_town_quest_form" method="POST" action="/delete_town_quest" onsubmit="return confirm('Are you sure you want to delete this Town-Quest relationship?');">
                <input type="hidden" name="delete_town_id" value="{{ town_quest.Towns_TownID }}">
                <input type="hidden" name="delete_town_name" value="{{ town_quest.Town }}">
                <input type="hidden" name="delete_quest_id" value="{{ town_quest.Quests_QuestID }}">
                <input type="hidden" name="delete_quest_name" value="{{ town_quest.Quest }}">
                <td>
                    <button type="submit">
                        Delete
                    </button>
                </td>
            </form>
        </tr>
        {% endfor %}
    </tbody>
</table>

{# CREATE form for town_quests #}
<h2>Create a Town-Quest Relationship</h2>
<form class="cuForm" id="create_town_quest_form" method="POST" action="/town_quests/create">
    
    <label for="town_id">Select a Town:</label>
    <select name="town_id" id="town_id" required>
        <option value="" disabled selected>Select a Town</option>
        {% for town in towns %}
        <option value="{{ town.TownID }}">{{ town.TownID }} - {{ town.TownName }}</option>
        {% endfor %}
    </select>

    <label for="quest_id">Select a Quest:</label>
    <select name="quest_id" id="quest_id" required>
        <option value="" disabled selected>Select a Quest</option>
        {% for quest in quests %}
        <option value="{{ quest.QuestID }}">{{ quest.QuestID }} - {{ quest.QuestName }}</option>
        {% endfor %}
    </select>

    <input type="submit" value="Create Relationship">
</form>

{# UPDATE form for town_quests #}
<h2>Update a Town-Quest Relationship</h2>
<form class="cuForm" id="update_town_quest_form" method="POST" action="/town_quests/update">
    <label for="original_town_quest">Relationship to Update: </label>
    <select name="original_town_quest" id="original_town_quest" required>
        <option value="" disabled selected>Select a Town-Quest Relationship</option>
        {% for town_quest in town_quests %}
        <option value="{{ town_quest.Towns_TownID }},{{ town_quest.Quests_QuestID }}">
            Town: {{ town_quest.Town }} - Quest: {{ town_quest.Quest }}
        </option>
        {% endfor %}
    </select>

    <label for="town_id">Updated Town:</label>
    <select name="town_id" id="town_id" required>
        <option value="" disabled selected>Select a Town</option>
        {% for town in towns %}
        <option value="{{ town.TownID }}">{{ town.TownID }} - {{ town.TownName }}</option>
        {% endfor %}
    </select>

    <label for="quest_id">Updated Quest:</label>
    <select name="quest_id" id="quest_id" required>
        <option value="" disabled selected>Select a Quest</option>
        {% for quest in quests %}
        <option value="{{ quest.QuestID }}">{{ quest.QuestID }} - {{ quest.QuestName }}</option>
        {% endfor %}
    </select>

    <input type="submit" value="Update Relationship">
</form>

{% endblock %}
